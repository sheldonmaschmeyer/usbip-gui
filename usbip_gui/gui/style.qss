QMainWindow { background-color: #1e1e2e; color: #cdd6f4; }
QWidget { background-color: #1e1e2e; color: #cdd6f4; }
QTabWidget::pane { border: 1px solid #313244; }
QTabBar::tab {
    background: #313244;
    color: #cdd6f4;
    padding: 10px;
    border-top: 2px solid transparent;
}
QTabBar::tab:selected {
    background: #1e1e2e;
    color: #89b4fa;
    border-top: 2px solid #89b4fa;
}
QLineEdit {
    background: #181825;
    border: 1px solid #313244;
    padding: 4px;
}
QPushButton { background: #313244; border: none; padding: 5px; }
QPushButton:hover { background: #45475a; }
QPushButton:pressed { background: #89b4fa; color: #1e1e2e; }
QTreeWidget {
    font-size: 12pt;
    background: #181825;
    alternate-background-color: #1e1e2e;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
    border: none;
}
QTreeView {
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
    show-decoration-selected: 1;
}
QTreeWidget::item:selected,
QTreeWidget::item:selected:active,
QTreeWidget::item:selected:!active {
    background-color: #89b4fa;
    color: #1e1e2e;
}
QTreeView::item:selected,
QTreeView::item:selected:active,
QTreeView::item:selected:!active {
    background-color: #89b4fa;
    color: #1e1e2e;
}
QTreeWidget::item:hover {
    background: #313244;
}
QHeaderView::section {
    font-size: 12pt;
    background: #313244;
    color: #cdd6f4;
    border: 1px solid #313244;
    padding: 4px;
}
QMenu { background: #313244; color: #cdd6f4; }
QMenu::item:selected { background: #45475a; }
QMenuBar { background: #1e1e2e; color: #cdd6f4; }
QMenuBar::item:selected { background: #45475a; }
QMessageBox { background-color: #1e1e2e; color: #cdd6f4; }
